<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="PharmacyDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=PharmacyDB;Integrated Security=True;Connect Timeout=8;"
         providerName="System.Data.SqlClient" />
    <add name="Master"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=master;Integrated Security=True;Connect Timeout=8;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ServerInstance" value=".\SQLEXPRESS" />
    <add key="DatabaseName" value="PharmacyDB" />
    <add key="LegacyDatabaseName" value="PharmacyoumS" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
